{"data":{"deltas":[{"range":{"end":{"character":0,"line":13},"start":{"character":0,"line":11}},"text":"/// A color, with each channel from 0 to 255.\npub type Color {\n  Color(r: Int, g: Int, b: Int)\n}\n\npub type Shape {\n  Line(start: Point, end: Point)\n  // A straight line in a chosen color.\n  ColorLine(start: Point, end: Point, color: Color)\n  // Part of a circle, drawn from angle `from` toward angle `to` (degrees).\n  Arc(center: Point, radius: Float, from: Float, to: Float, color: Color)\n  // A cubic Bezier curve.\n  Curve(start: Point, control1: Point, control2: Point, end: Point, color: Color)\n"}],"path":"src\\shape.gleam","source":"paste_likely"},"hash":"a368bb1638e2ae5a58aea481627f8418b7a4aa003518c1d0dc9a4ea5c7d40912","kind":"doc.change","prev_hash":"f93daf73a2230021a427d08c76216e167f8de102ea50773a1c670f2e55e37fbc","seq":289,"t":2706137,"wall":"2026-11-24T01:01:40.516Z"}
{"data":{"content":"  // Extension: colors and colored shapes (see extension.txt).\n  #(\"Rgb\", [\"r\", \"g\", \"b\"]),\n  #(\"ColorLine\", [\"start\", \"end\", \"color\"]),\n  #(\"Arc\", [\"center\", \"radius\", \"from\", \"to\", \"color\"]),\n  #(\"Curve\", [\"start\", \"control1\", \"control2\", \"end\", \"color\"]),\n","length":259,"path":"src\\evaluator.gleam","range":{"end":{"character":0,"line":33},"start":{"character":0,"line":33}},"sha256":"8dc3d14913241458ea7141195488de93103637fc7d4e7996787d1a3a3a53dc9a"},"hash":"aa6ef37606959826ca435bdd131621513dc0bfd577822cd733827f59d5bd0384","kind":"paste","prev_hash":"a368bb1638e2ae5a58aea481627f8418b7a4aa003518c1d0dc9a4ea5c7d40912","seq":290,"t":2706374,"wall":"2026-11-24T01:01:40.753Z"}
{"data":{"path":"src\\evaluator.gleam","range":{"end":{"character":51,"line":142},"start":{"character":51,"line":142}},"was_selection":false},"hash":"c4afc01e01015f5ea1a55feb869f5b9ec8b26d248a009760783129375627b299","kind":"selection.change","prev_hash":"aa6ef37606959826ca435bdd131621513dc0bfd577822cd733827f59d5bd0384","seq":291,"t":2706375,"wall":"2026-11-24T01:01:40.754Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":45},"start":{"character":0,"line":2}},"text":"import gleam/float\nimport gleam/int\nimport gleam/list\nimport gleam/string\nimport shape.{\n  type Color, type Path, type Point, Arc, ColorLine, Curve, Line, Point,\n}\n\n/// One path as canvas.mjs setDrawing consumes it (field by field): the\n/// polyline, stroke colour/width, and the start and end times (in tenths of a second)\n/// between which the reveal runs — so the renderer's clock needs no shape\n/// knowledge.\npub type RenderPath {\n  RenderPath(\n    points: List(Point),\n    thickness: Float,\n    color: String,\n    start: Float,\n    end: Float,\n  )\n}\n\n// ── The canvas (canvas.mjs) ───────────────────────────────────────────────────\n\n/// Replace the drawing being animated in the page's\n/// `<canvas id=\"animation-canvas\">` element. If that element doesn't appear within\n/// about 10 seconds, this logs an error to the browser console. This keeps the\n/// current time, so a drawing that replaces a finished one appears complete. To\n/// animate it from the start, also call reset_clock.\n@external(javascript, \"./canvas.mjs\", \"setDrawing\")\npub fn set_drawing(paths: List(RenderPath)) -> Nil\n\n/// Set the animation's speed, as a multiple of its normal speed: 1.0 is normal and\n/// is where it starts, 0.0 pauses, and a negative rate plays it backward.\n/// Time stops at the start of the drawing and when its last path finishes, so\n/// playing a finished drawing again takes a call to reset_clock.\n@external(javascript, \"./canvas.mjs\", \"setSpeed\")\npub fn set_speed(rate: Float) -> Nil\n\n/// Jump the animation back to its start, where the canvas is empty.\n@external(javascript, \"./canvas.mjs\", \"resetClock\")\npub fn reset_clock() -> Nil\n\n/// The RenderPath for a path. `color` is the palette colour, used by shapes\n/// that don't choose their own.\npub fn render_path(path: Path, color: String) -> RenderPath {\n  let #(points, stroke) = case path.shape {\n    Line(a, b) -> #([a, b], color)\n    ColorLine(a, b, c) -> #([a, b], css_color(c))\n    Arc(center, radius, from, to, c) -> #(\n      arc_points(center, radius, from, to),\n      css_color(c),\n    )\n    Curve(p0, p1, p2, p3, c) -> #(bezier_points(p0, p1, p2, p3), css_color(c))\n  }\n  RenderPath(points, path.thickness, stroke, path.start, path.end)\n}\n\n/// A CSS colour string such as \"rgb(255,0,128)\".\npub fn css_color(c: Color) -> String {\n  let channel = fn(x) { int.to_string(int.clamp(x, 0, 255)) }\n  \"rgb(\"\n  <> string.join([channel(c.r), channel(c.g), channel(c.b)], \",\")\n  <> \")\"\n}\n\nconst pi = 3.141592653589793\n\n// Points evenly spaced along the arc, so the reveal advances at a steady rate.\n// Positive y points down the screen, so increasing angles turn clockwise.\nfn arc_points(center: Point, radius: Float, from: Float, to: Float) -> List(Point) {\n  let sweep = to -. from\n  // About one point per 5 degrees, and at least 2.\n  let steps = int.max(2, float.round(float.absolute_value(sweep) /. 5.0))\n  list.map(list.range(0, steps), fn(i) {\n    let degrees = from +. sweep *. int.to_float(i) /. int.to_float(steps)\n    let radians = degrees *. pi /. 180.0\n    Point(\n      center.x +. radius *. cos(radians),\n      center.y +. radius *. sin(radians),\n    )\n  })\n}\n\n// Points along a cubic Bezier curve.\nfn bezier_points(p0: Point, p1: Point, p2: Point, p3: Point) -> List(Point) {\n  let steps = 40\n  list.map(list.range(0, steps), fn(i) {\n    let t = int.to_float(i) /. int.to_float(steps)\n    let u = 1.0 -. t\n    let a = u *. u *. u\n    let b = 3.0 *. u *. u *. t\n    let c = 3.0 *. u *. t *. t\n    let d = t *. t *. t\n    Point(\n      a *. p0.x +. b *. p1.x +. c *. p2.x +. d *. p3.x,\n      a *. p0.y +. b *. p1.y +. c *. p2.y +. d *. p3.y,\n    )\n  })\n}\n\n@external(javascript, \"./render_ffi.mjs\", \"sin\")\nfn sin(x: Float) -> Float\n\n@external(javascript, \"./render_ffi.mjs\", \"cos\")\nfn cos(x: Float) -> Float\n"}],"path":"src\\render.gleam","source":"paste_likely"},"hash":"941a46794b1d701274119e02c62dd7ee1347da71084600bf4e9d5ec0ef9d2117","kind":"doc.change","prev_hash":"c4afc01e01015f5ea1a55feb869f5b9ec8b26d248a009760783129375627b299","seq":292,"t":2706715,"wall":"2026-11-24T01:01:41.094Z"}
{"data":{"diff_size":122,"new_content":"// Trigonometry for render.gleam and builtins.gleam (radians).\n\nexport const sin = Math.sin;\nexport const cos = Math.cos;\n","new_content_size":122,"new_hash":"01cf245779d93c2df8c026c231f6eea48a7ab200e72ce1baccbe2dfde87b2d48","old_hash":"","operation":"create","path":"src/render_ffi.mjs"},"hash":"e449f4705eb65d377dc716982519dbf550eefd74d478f53b17faf81455f29100","kind":"fs.external_change","prev_hash":"941a46794b1d701274119e02c62dd7ee1347da71084600bf4e9d5ec0ef9d2117","seq":293,"t":2706716,"wall":"2026-11-24T01:01:41.095Z"}
