{"data":{"deltas":[{"range":{"end":{"character":0,"line":108},"start":{"character":0,"line":76}},"text":"  list.map(upto(steps), fn(i) {\n    let degrees = from +. sweep *. int.to_float(i) /. int.to_float(steps)\n    let radians = degrees *. pi /. 180.0\n    Point(\n      center.x +. radius *. cos(radians),\n      center.y +. radius *. sin(radians),\n    )\n  })\n}\n\n// Points along a cubic Bezier curve.\nfn bezier_points(p0: Point, p1: Point, p2: Point, p3: Point) -> List(Point) {\n  let steps = 40\n  list.map(upto(steps), fn(i) {\n    let t = int.to_float(i) /. int.to_float(steps)\n    let u = 1.0 -. t\n    let a = u *. u *. u\n    let b = 3.0 *. u *. u *. t\n    let c = 3.0 *. u *. t *. t\n    let d = t *. t *. t\n    Point(\n      a *. p0.x +. b *. p1.x +. c *. p2.x +. d *. p3.x,\n      a *. p0.y +. b *. p1.y +. c *. p2.y +. d *. p3.y,\n    )\n  })\n}\n\n@external(javascript, \"./render_ffi.mjs\", \"sin\")\nfn sin(x: Float) -> Float\n\n@external(javascript, \"./render_ffi.mjs\", \"cos\")\nfn cos(x: Float) -> Float\n\n// The list [0, 1, ..., n].\nfn upto(n: Int) -> List(Int) {\n  upto_loop(n, [])\n}\n\nfn upto_loop(n: Int, acc: List(Int)) -> List(Int) {\n  case n < 0 {\n    True -> acc\n    False -> upto_loop(n - 1, [n, ..acc])\n  }\n}\n"}],"path":"src\\render.gleam","source":"paste_likely"},"hash":"0fe5dbfc9233a9a7fa6d89def14d16f6d34c6f93610991eb855daf9b7e1765eb","kind":"doc.change","prev_hash":"0b38c8aeeb06e254dd0bd82eccf291e24754887ef963bbeb0d4b9b34c40dc92c","seq":297,"t":2713133,"wall":"2026-11-24T01:01:47.512Z"}
