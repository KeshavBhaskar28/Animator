{"data":{"deltas":[{"range":{"end":{"character":0,"line":73},"start":{"character":0,"line":63}},"text":"  \"rgb(\" <> string.join([channel(c.r), channel(c.g), channel(c.b)], \",\") <> \")\"\n}\n\nconst pi = 3.141592653589793\n\n// Points evenly spaced along the arc, so the reveal advances at a steady rate.\n// Positive y points down the screen, so increasing angles turn clockwise.\nfn arc_points(\n  center: Point,\n  radius: Float,\n  from: Float,\n  to: Float,\n) -> List(Point) {\n"}],"path":"src\\render.gleam","source":"paste_likely"},"hash":"2fc9240aefab7f63552e620ec070776790e860e9a6278ae450450c80bc828f90","kind":"doc.change","prev_hash":"c645f13bbfa9b090fea6303871e300364758adb0fa0fafbf5fd9e281729c519e","seq":307,"t":2806471,"wall":"2026-11-24T01:03:20.849Z"}
