{"data":{"deltas":[{"range":{"end":{"character":0,"line":226},"start":{"character":0,"line":0}},"text":"//// Animator -- an application for program-generated drawings.\n\nimport builtins\nimport drawing\nimport editor\nimport errors\nimport gleam/float\nimport gleam/int\nimport gleam/list\nimport gleam/option.{type Option, None, Some}\nimport gleam/result\nimport lustre\nimport lustre/attribute as attr\nimport lustre/effect.{type Effect}\nimport lustre/element.{type Element}\nimport lustre/element/html\nimport lustre/event\nimport parser\nimport render\nimport shape.{type Path}\n\n/// Your app's public address, once you've deployed it in Problem 13, such as\n/// \"https://your-username.github.io/animator/\".\npub const public_url = \"\"\n\n/// Set to True if you would like your app's URL included in the course gallery.\npub const include_app_in_gallery = False\n\n/// A link to your video from Problem 14, which anyone with the link can watch.\npub const video_url = \"\"\n\n/// Set to True if you would like your video included in the course gallery.\npub const include_video_in_gallery = False\n\nconst default_code = \"fn draw(shape_slider: Int) -> List(Path) {\\n  [Path(Line(Point(0, 0), Point(100, 100)), 0, 10, 2)]\\n}\\n\"\n\n// ── Model ──────────────────────────────────────────────────────────────────────\n\npub type Model {\n  Model(\n    // The code in the editor.\n    source: String,\n    // Whether the code editor is shown.\n    code_open: Bool,\n    // The error from the latest edit, if the code failed to parse or evaluate.\n    error: Option(String),\n    // The animation speed, as a multiple of normal speed, in [-3, 3].\n    speed: Float,\n  )\n}\n\n// Colors given to paths in turn.\nconst palette = [\"#f2c14e\", \"#4ecdc4\", \"#ff6b6b\", \"#a78bfa\", \"#7bd389\"]\n\npub type Msg {\n  SetCode(String)\n\n  // Layout controls\n  ToggleCode\n\n  // Playback controls: the speed slider's new value, as the input's text.\n  SetSpeed(String)\n}\n\n// ── Init ───────────────────────────────────────────────────────────────────────\n\npub fn init(_flags: Nil) -> #(Model, Effect(Msg)) {\n  #(\n    Model(source: \"\", code_open: True, error: None, speed: 1.0),\n    // Effects that happen automatically at the start go here.\n    effect.batch([\n      editor.mount(default_code, SetCode),\n      effect.from(fn(dispatch) { dispatch(SetCode(default_code)) }),\n    ]),\n  )\n}\n\n// Parse and evaluate a draw function at the given shape-slider value, returning\n// the rendered paths on success, or a human-readable message on failure.\nfn run_source(shape_slider: Int, source: String) -> Result(List(Path), String) {\n  case parser.parse_program(source, builtins.global_frame()) {\n    Error(msg) -> Error(msg)\n    Ok(program) ->\n      drawing.try_draw(shape_slider, program)\n      // Convert Error(EvalError) to Error(String) with a useful error message.\n      |> result.map_error(errors.error_message)\n  }\n}\n\n// ── Update ─────────────────────────────────────────────────────────────────────\n\npub fn update(model: Model, msg: Msg) -> #(Model, Effect(Msg)) {\n  case msg {\n    ToggleCode -> #(Model(..model, code_open: !model.code_open), effect.none())\n\n    // After each keystroke in the editor, evaluate user code and animate it, or\n    // report the error. set_drawing runs on every successful edit, even when the\n    // drawing is empty or unchanged.\n    SetCode(text) ->\n      case run_source(10, text) {\n        Ok(paths) -> #(\n          Model(..model, error: None, source: text),\n          set_drawing(paths),\n        )\n        // Broken (parse or evaluation): keep the last drawing and show the error.\n        Error(msg) -> #(Model(..model, error: Some(msg), source: text), effect.none())\n      }\n\n    SetSpeed(text) -> {\n      let speed = parse_number(text) |> result.unwrap(model.speed)\n      #(\n        Model(..model, speed: speed),\n        effect.from(fn(_) { render.set_speed(speed) }),\n      )\n    }\n  }\n}\n\n// Convert paths to RenderPaths, cycling through the palette, and animate them.\nfn set_drawing(paths: List(Path)) -> Effect(Msg) {\n  let render_paths =\n    list.index_map(paths, fn(path, i) {\n      render.render_path(path, color_at(i))\n    })\n  effect.from(fn(_) { render.set_drawing(render_paths) })\n}\n\nfn color_at(i: Int) -> String {\n  let n = list.length(palette)\n  palette\n  |> list.drop(i % n)\n  |> list.first\n  |> result.unwrap(\"#f2c14e\")\n}\n\n// A range input reports \"1\" or \"-0.5\"; float.parse rejects whole numbers.\nfn parse_number(text: String) -> Result(Float, Nil) {\n  case float.parse(text) {\n    Ok(x) -> Ok(x)\n    Error(_) -> int.parse(text) |> result.map(int.to_float)\n  }\n}\n\n// ── View ──────────────────────────────────────────────────────────────────\n//\n// Two side-by-side panes: the code editor on the left and its rendered output on\n// the right. The code column can be hidden to expand the right pane.\n\npub fn view(model: Model) -> Element(Msg) {\n  let app_class = case model.code_open {\n    True -> \"app\"\n    False -> \"app code-hidden\"\n  }\n  // The code column still exists even when hidden (CSS collapses it) so the\n  // mounted CodeMirror editor keeps its state across show/hide.\n  html.div([attr.class(app_class)], [\n    html.div([attr.class(\"code-col\")], [\n      editor.view_panel(ToggleCode),\n    ]),\n    view_anim(model),\n  ])\n}\n\nfn view_anim(model: Model) -> Element(Msg) {\n  html.div([attr.class(\"canvas-area\")], [\n    view_reveal_code(model),\n    html.canvas([attr.id(\"animation-canvas\"), attr.class(\"canvas\")]),\n    view_error(model.error),\n    view_controls(model),\n  ])\n}\n\n// The latest error, overlaid on the canvas, which keeps the last good drawing.\nfn view_error(error: Option(String)) -> Element(Msg) {\n  case error {\n    None -> element.none()\n    Some(msg) -> html.pre([attr.class(\"error-banner\")], [html.text(msg)])\n  }\n}\n\n// Playback controls along the bottom of the animation pane.\nfn view_controls(model: Model) -> Element(Msg) {\n  html.div([attr.class(\"controls\")], [\n    html.label([attr.class(\"control\"), attr.for(\"speed-slider\")], [\n      html.span([attr.class(\"control-label\")], [\n        html.text(\"Speed \" <> float.to_string(model.speed) <> \"×\"),\n      ]),\n      html.input([\n        attr.type_(\"range\"),\n        attr.id(\"speed-slider\"),\n        attr.attribute(\"data-test-id\", \"speed-slider\"),\n        attr.min(\"-3\"),\n        attr.max(\"3\"),\n        attr.step(\"0.1\"),\n        attr.value(float.to_string(model.speed)),\n        event.on_input(SetSpeed),\n      ]),\n    ]),\n  ])\n}\n\n// The button that brings the code column back, overlaid on the top-left of the\n// right pane. Nothing is rendered while the column is already showing (its own\n// header holds the button that hides it).\nfn view_reveal_code(model: Model) -> Element(Msg) {\n  case model.code_open {\n    True -> element.none()\n    False ->\n      html.button(\n        [\n          attr.class(\"icon-btn reveal-code\"),\n          attr.attribute(\"title\", \"Show code\"),\n          event.on_click(ToggleCode),\n        ],\n        [html.text(\"⟩\")],\n      )\n  }\n}\n\n// ── Main ───────────────────────────────────────────────────────────────────────\n\npub fn main() -> Nil {\n  let app = lustre.application(init, update, view)\n  let assert Ok(_) = lustre.start(app, \"#app\", Nil)\n  Nil\n}\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"ff32bafb916e96059f097f2413e0989fca8eee019eabb467fe7bab9ecf43d894","kind":"doc.change","prev_hash":"402532f8cb112924f43cd1629363292ad2be0e9b012009a037c4c7884dec5ca0","seq":130,"t":1070896,"wall":"2026-11-24T00:34:25.274Z"}
{"data":{"deltas":[{"range":{"end":{"character":0,"line":124},"start":{"character":0,"line":34}},"text":"const default_code =\n  \"fn draw(shape_slider: Int) -> List(Path) {\\n  [Path(Line(Point(0, 0), Point(100, 100)), 0, 10, 2)]\\n}\\n\"\n\n// ── Model ──────────────────────────────────────────────────────────────────────\n\npub type Model {\n  Model(\n    // The code in the editor.\n    source: String,\n    // Whether the code editor is shown.\n    code_open: Bool,\n    // The error from the latest edit, if the code failed to parse or evaluate.\n    error: Option(String),\n    // The animation speed, as a multiple of normal speed, in [-3, 3].\n    speed: Float,\n  )\n}\n\n// Colors given to paths in turn.\nconst palette = [\"#f2c14e\", \"#4ecdc4\", \"#ff6b6b\", \"#a78bfa\", \"#7bd389\"]\n\npub type Msg {\n  SetCode(String)\n\n  // Layout controls\n  ToggleCode\n\n  // Playback controls: the speed slider's new value, as the input's text.\n  SetSpeed(String)\n}\n\n// ── Init ───────────────────────────────────────────────────────────────────────\n\npub fn init(_flags: Nil) -> #(Model, Effect(Msg)) {\n  #(\n    Model(source: \"\", code_open: True, error: None, speed: 1.0),\n    // Effects that happen automatically at the start go here.\n    effect.batch([\n      editor.mount(default_code, SetCode),\n      effect.from(fn(dispatch) { dispatch(SetCode(default_code)) }),\n    ]),\n  )\n}\n\n// Parse and evaluate a draw function at the given shape-slider value, returning\n// the rendered paths on success, or a human-readable message on failure.\nfn run_source(shape_slider: Int, source: String) -> Result(List(Path), String) {\n  case parser.parse_program(source, builtins.global_frame()) {\n    Error(msg) -> Error(msg)\n    Ok(program) ->\n      drawing.try_draw(shape_slider, program)\n      // Convert Error(EvalError) to Error(String) with a useful error message.\n      |> result.map_error(errors.error_message)\n  }\n}\n\n// ── Update ─────────────────────────────────────────────────────────────────────\n\npub fn update(model: Model, msg: Msg) -> #(Model, Effect(Msg)) {\n  case msg {\n    ToggleCode -> #(Model(..model, code_open: !model.code_open), effect.none())\n\n    // After each keystroke in the editor, evaluate user code and animate it, or\n    // report the error. set_drawing runs on every successful edit, even when the\n    // drawing is empty or unchanged.\n    SetCode(text) ->\n      case run_source(10, text) {\n        Ok(paths) -> #(\n          Model(..model, error: None, source: text),\n          set_drawing(paths),\n        )\n        // Broken (parse or evaluation): keep the last drawing and show the error.\n        Error(msg) -> #(\n          Model(..model, error: Some(msg), source: text),\n          effect.none(),\n        )\n      }\n\n    SetSpeed(text) -> {\n      let speed = parse_number(text) |> result.unwrap(model.speed)\n      #(\n        Model(..model, speed: speed),\n        effect.from(fn(_) { render.set_speed(speed) }),\n      )\n    }\n  }\n}\n\n// Convert paths to RenderPaths, cycling through the palette, and animate them.\nfn set_drawing(paths: List(Path)) -> Effect(Msg) {\n  let render_paths =\n    list.index_map(paths, fn(path, i) { render.render_path(path, color_at(i)) })\n"}],"path":"src\\app.gleam","source":"paste_likely"},"hash":"e1710c040e07aba098670464f26a97825d100a9cac635e0fd8c23e1c1bf27713","kind":"doc.change","prev_hash":"ff32bafb916e96059f097f2413e0989fca8eee019eabb467fe7bab9ecf43d894","seq":131,"t":1070898,"wall":"2026-11-24T00:34:25.277Z"}
