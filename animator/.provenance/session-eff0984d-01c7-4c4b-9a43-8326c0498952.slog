ences-view","version":"10.0.0"},{"enabled":false,"id":"vscode.restructuredtext","version":"10.0.0"},{"enabled":false,"id":"vscode.ruby","version":"10.0.0"},{"enabled":false,"id":"vscode.rust","version":"10.0.0"},{"enabled":false,"id":"vscode.scss","version":"10.0.0"},{"enabled":false,"id":"vscode.search-result","version":"10.0.0"},{"enabled":false,"id":"vscode.shaderlab","version":"10.0.0"},{"enabled":false,"id":"vscode.shellscript","version":"10.0.0"},{"enabled":false,"id":"vscode.simple-browser","version":"10.0.0"},{"enabled":false,"id":"vscode.sql","version":"10.0.0"},{"enabled":false,"id":"vscode.swift","version":"10.0.0"},{"enabled":false,"id":"vscode.terminal-suggest","version":"1.0.1"},{"enabled":false,"id":"vscode.theme-abyss","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-defaults","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-kimbie-dark","version":"10.0.0"},{"enabled":false,"id":"vscode.vscode-modern-icons","version":"1.0.0"},{"enabled":false,"id":"vscode.theme-monokai","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-monokai-dimmed","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-quietlight","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-red","version":"10.0.0"},{"enabled":false,"id":"vscode.vscode-theme-seti","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-solarized-dark","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-solarized-light","version":"10.0.0"},{"enabled":false,"id":"vscode.theme-tomorrow-night-blue","version":"10.0.0"},{"enabled":false,"id":"vscode.tunnel-forwarding","version":"10.0.0"},{"enabled":false,"id":"vscode.typescript","version":"10.0.0"},{"enabled":false,"id":"vscode.typescript-language-features","version":"10.0.0"},{"enabled":false,"id":"vscode.vb","version":"10.0.0"},{"enabled":false,"id":"vscode.xml","version":"10.0.0"},{"enabled":false,"id":"vscode.yaml","version":"10.0.0"},{"enabled":true,"id":"berkeley-ai4ed.preceptor","version":"0.1.6"},{"enabled":false,"id":"espressif.esp-idf-extension","version":"2.3.0"},{"enabled":false,"id":"gleam.gleam","version":"2.13.1"},{"enabled":false,"id":"itsgeagle.provenance-recorder","version":"2.0.2"},{"enabled":false,"id":"ms-python.debugpy","version":"2026.6.0"},{"enabled":false,"id":"ms-python.python","version":"2026.10.0"},{"enabled":false,"id":"ms-python.vscode-pylance","version":"2026.4.1"},{"enabled":false,"id":"ms-python.vscode-python-envs","version":"1.44.0"},{"enabled":false,"id":"ms-vscode.cpptools","version":"1.35.6"},{"enabled":false,"id":"ms-vsliveshare.vsliveshare","version":"1.1.122"}]},"hash":"31e532d1b3ef311a49a67e1ec7aed7d0404dae490f7da691541dee0928f626a6","kind":"ext.snapshot","prev_hash":"65f733222fdf3bfde00d4b5eb945bb72b3fcb221f313f0cdd8b264b725732dc2","seq":1,"t":7,"wall":"2026-11-19T03:09:09.366Z"}
{"data":{"content":"/* All styling for the Animator app. Its code only attaches class names. */\n\n* { margin: 0; padding: 0; box-sizing: border-box; }\nhtml, body { width: 100%; height: 100%; overflow: hidden; }\n\n/* ── Layout: two columns ─────────────────────────────────────────────────── */\n\n.app {\n  display: flex;\n  width: 100vw;\n  height: 100vh;\n  background: #1a1a2e;\n  color: #d4c5a0;\n  font-family: system-ui, sans-serif;\n  font-size: 14px;\n}\n\n/* Left column: the code editor. */\n.code-col {\n  width: 42%;\n  min-width: 320px;\n  max-width: 720px;\n  flex-shrink: 0;\n  display: flex;\n  border-right: 1px solid #3a3a5e;\n  background: #0f0f1e;\n}\n\n/* The code column stays in the DOM when collapsed, so CodeMirror keeps its\n   state; hiding it gives the right column the full width. */\n.app.code-hidden .code-col { display: none; }\n\n/* A small emoji button (the code pane's collapse toggle, and the playback\n   controls once they exist). */\n.icon-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  background: #2a2a4a;\n  color: #d4c5a0;\n  border: 1px solid #4a4a8a;\n  border-radius: 4px;\n  cursor: pointer;\n  font-size: 14px;\n  line-height: 1;\n  padding: 5px 8px;\n}\n.icon-btn:hover { background: #3a3a5e; }\n\n/* ── Code panel (left column) ───────────────────────────────────────────── */\n\n.code-panel {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n.code-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 10px 14px;\n  background: #1a1a3e;\n  border-bottom: 1px solid #3a3a5e;\n}\n.code-title {\n  color: #e8d8b0;\n  font-family: 'Georgia', serif;\n  font-size: 16px;\n  letter-spacing: 1px;\n}\n\n/* Wrapper holding the editor. */\n.code-editor-wrap {\n  flex: 1;\n  min-height: 0;\n  position: relative;\n  display: flex;\n}\n/* CodeMirror mount node: grows to fill the panel. */\n.code-editor {\n  flex: 1;\n  min-height: 0;\n  display: flex;\n  overflow: hidden;\n  background: #0d0d1a;\n}\n.code-editor .cm-editor { width: 100%; height: 100%; }\n\n/* Collapsible reference of the built-ins available to draw functions. */\n.reference {\n  margin: 8px 14px 0;\n  border: 1px solid #3a3a5e;\n  border-radius: 4px;\n  background: #0d0d1a;\n  overflow: hidden;\n}\n.reference-summary {\n  padding: 6px 12px;\n  cursor: pointer;\n  color: #b8a888;\n  font-family: monospace;\n  font-size: 12px;\n  user-select: none;\n}\n.reference-summary:hover { color: #e8d8b0; }\n.reference-body {\n  padding: 4px 12px 10px;\n  border-top: 1px solid #3a3a5e;\n}\n.reference-group { margin-top: 8px; }\n.reference-group-title {\n  color: #8a8aca;\n  font-family: monospace;\n  font-size: 11px;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n  margin-bottom: 4px;\n}\n.reference-row {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  gap: 4px 10px;\n  padding: 1px 0;\n}\n.reference-sig {\n  color: #89ddff;\n  font-family: monospace;\n  font-size: 12px;\n  white-space: pre;\n}\n.reference-desc { color: #6a7a8a; font-size: 11px; }\n\n/* ── Animation area (right column) ──────────────────────────────────────── */\n\n.canvas-area {\n  flex: 1;\n  min-width: 0;\n  overflow: hidden;\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: #0a0a14;\n  container-type: size;\n}\n\n/* The interpreter's List(Path) (or its error), shown as text before the\n   animation pane is built. */\n.output {\n  align-self: stretch;\n  margin: 0;\n  padding: 16px;\n  overflow: auto;\n  font-family: ui-monospace, \"SF Mono\", Menlo, monospace;\n  font-size: 13px;\n  line-height: 1.5;\n  color: #cfe3ff;\n  white-space: pre-wrap;\n  word-break: break-word;\n}\n/* Leave room for the reveal button, which only overlays this pane while the\n   code column is hidden. */\n.app.code-hidden .output { padding-top: 48px; }\n\n/* Button that reveals the code column again when it is hidden. */\n.reveal-code {\n  position: absolute;\n  top: 12px;\n  left: 12px;\n  z-index: 10;\n}\n\n/* A centred square that fits the (possibly non-square) animation area. Give your\n   <canvas> this class, so that drawings aren't stretched. */\n.canvas {\n  width: min(100cqw, 100cqh);\n  height: min(100cqw, 100cqh);\n}\n\n","line_count":184,"path":"animator.css","sha256":"bfedb7ae247ddb7fa84dc997c482498d63b5b810506adec3b099e1dd1fd78d53"},"hash":"4125c032ea52fa4ef15eb218b809d03e12c1dec95ba02bcb37f7c5e1a2726d1c","kind":"doc.open","prev_hash":"31e532d1b3ef311a49a67e1ec7aed7d0404dae490f7da691541dee0928f626a6","seq":2,"t":838,"wall":"2026-11-19T03:09:10.196Z"}
